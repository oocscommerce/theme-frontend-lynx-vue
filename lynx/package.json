{
  "name": "oocs-lynx",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    ".lynx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build:ssr": "npm run type-check && vite build --ssr src/ssr.ts",
    "build:ssr:worker": "npm run type-check && vite build --ssr src/ssr-worker.ts --mode worker",
    "deploy:ssr:worker": "wrangler deploy",
    "tail:ssr:worker": "wrangler tail",
    "ssr": "node --enable-source-maps ./dist/ssr/nodejs/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "lynx-tsconfig-vue && vue-tsc -p tsconfig.modules.json --noEmit",
    "lint": "lynx-lint-vue",
    "format": "lynx-format-vue",
    "format:check": "lynx-format-vue --check"
  },
  "dependencies": {
    "@fontsource/mulish": "5.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-ssr-friendly": "1.3.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.2",
    "vue-eslint-parser": "10.4.1",
    "wrangler": "4.150.0"
  }
}
